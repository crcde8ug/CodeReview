                "85:         if (token.getSessionId() == null) {",
                "86:             if (sessionType.isAllowTransientUserSession()) {",
                "87:                 return createTransientSessionForClient(session, realm, token, client);",
                "88:             } else {",
                "89:                 return UserSessionValidationResult.error(Errors.USER_SESSION_NOT_FOUND);",
                "90:             }"
