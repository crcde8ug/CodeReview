    "snippet": "135:     /**\n136:      * Returns the aliases of all identity providers whose {@code firstBrokerLoginFlowId} or {@code postBrokerLoginFlowId}\n137:      * matches the provided {@code flowId}.\n138:      *\n139:      * @param flowId the id of the flow.\n140:      * @param search an optional {@link String} representing an identity provider alias (partial or exact). If the value is enclosed\n141:      *               in double quotes, the method treats it as an exact search (e.g. {@code \"name\"}). If the value is enclosed in\n142:      *               wildcards, the method treats it as an infix search (e.g. {@code *name*}). Otherwise, the method treats it as a\n143:      *               prefix search (i.e. {@code name*} and {@code name} return the same results).\n144:      * @param first the position of the first result to be processed (pagination offset). Ignored if negative or {@code null}.\n145:      * @param max the maximum number of results to be returned. Ignored if negative or {@code null}.\n146:      * @return a non-null stream of {@link IdentityProviderModel}s that match the search criteria.\n147:      */\n148:     Stream<String> getByFlow(String flowId, String search, Integer first, Integer max);\n149: \n150:     /**\n151:      * Returns all identity providers available for login, according to the specified mode. An IDP can be used for login\n152:      * if it is enabled, is not a link-only IDP, and is not configured to be hidden on login page.\n153:      * </p>\n154:      * The mode parameter may narrow the list of IDPs that are available. {@code FETCH_MODE.REALM_ONLY} fetches only realm-level\n155:      * IDPs (i.e. those not associated with any org). {@code FETCH_MODE.ORG_ONLY} will work together with the {@code organizationId}\n156:      * parameter. If the latter is set, only the IDPs associated with that org will be returned. Otherwise, the method returns\n157:      * the IDPs associated with any org. {@code FETCH_MODE.ALL} combines both approaches, returning both the realm-level\n158:      * IDPs with those associated with organizations (or a specific organization as per the {@code organizationId} param).\n159:      *\n160:      * @param mode the fetch mode to be used. Can be {@code REALM_ONLY}, {@code ORG_ONLY}, or {@code ALL}.\n161:      * @param organizationId an optional organization ID. If present and the mode is not {@code REALM_ONLY}, the param indicates\n162:      *                       that only IDPs associated with the specified organization are to be returned.\n163:      * @return a non-null stream of {@link IdentityProviderModel}s that are suitable for being displayed in the login pages.\n164:      */\n165:     default Stream<IdentityProviderModel> getForLogin(FetchMode mode, String organizationId) {\n166:         Stream<IdentityProviderModel> result = Stream.of();\n167:         if (mode == FetchMode.REALM_ONLY || mode == FetchMode.ALL) {\n168:             // fetch all realm-only IDPs - i.e. those not associated with orgs.\n169:             Map<String, String> searchOptions = LoginFilter.getLoginSearchOptions();\n170:             searchOptions.put(IdentityProviderModel.ORGANIZATION_ID, null);\n171:             result = Stream.concat(result, getAllStream(searchOptions, null, null));\n172:         }\n173:         if (mode == FetchMode.ORG_ONLY || mode == FetchMode.ALL) {\n174:             // fetch IDPs associated with organizations.\n175:             Map<String, String> searchOptions = LoginFilter.getLoginSearchOptions();\n176:             if (organizationId != null) {\n177:                 // we want the IDPs associated with a specific org.\n178:                 searchOptions.put(IdentityProviderModel.ORGANIZATION_ID, organizationId);\n179:             } else {\n180:                 searchOptions.put(IdentityProviderModel.ORGANIZATION_ID_NOT_NULL, \"\");\n181:             }\n182:             result = Stream.concat(result, getAllStream(searchOptions, null, null));\n183:         }\n184:         return result;\n185:     }\n186: \n187:     /**\n188:      * Returns the number of IDPs in the realm.\n189:      *\n190:      * @return the number of IDPs found in the realm.\n191:      */\n192:     long count();\n193: \n194:     /**\n195:      * Checks whether the realm has any configured identity providers or not.\n196:      *\n197:      * @return {@code true} if the realm has at least one configured identity provider (federation is enabled); {@code false}\n198:      * otherwise.\n199:      */\n200:     default boolean isIdentityFederationEnabled() {\n201:         return getAllStream(Map.of(), 0, 1).findFirst().isPresent();\n202:     }\n203: \n204:     /**\n205:      * Enum to control how login identity providers should be fetched.\n206:      */\n207:     enum FetchMode {\n208:         /** only realm-level providers should be fetched (not linked to any organization) **/\n209:         REALM_ONLY,\n210:         /** only providers linked to organizations should be fetched **/\n211:         ORG_ONLY,\n212:         /** all providers should fetched, regardless of being linked to an organization or not **/\n213:         ALL\n214:     }\n215: ",
