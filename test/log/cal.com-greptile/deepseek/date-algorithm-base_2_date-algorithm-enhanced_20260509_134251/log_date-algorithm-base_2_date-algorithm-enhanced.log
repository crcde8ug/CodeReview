    "snippet": "60:  * Allows \"casting\" availability (days, startTime, endTime) given in UTC to a timeZone or utcOffset\n61:  */\n62: export function getWorkingHours(\n63:   relativeTimeUnit: {\n64:     timeZone?: string;\n65:     utcOffset?: number;\n66:   },\n67:   availability: { userId?: number | null; days: number[]; startTime: ConfigType; endTime: ConfigType }[]\n68: ) {\n69:   if (!availability.length) {\n70:     return [];\n71:   }\n72:   const utcOffset =\n73:     relativeTimeUnit.utcOffset ??\n74:     (relativeTimeUnit.timeZone ? dayjs().tz(relativeTimeUnit.timeZone).utcOffset() : 0);\n75: \n76:   const workingHours = availability.reduce((currentWorkingHours: WorkingHours[], schedule) => {\n77:     // Include only recurring weekly availability, not date overrides\n78:     if (!schedule.days.length) return currentWorkingHours;\n79:     // Get times localised to the given utcOffset/timeZone\n80:     const startTime =\n81:       dayjs.utc(schedule.startTime).get(\"hour\") * 60 +\n82:       dayjs.utc(schedule.startTime).get(\"minute\") -\n83:       utcOffset;\n84:     const endTime =\n85:       dayjs.utc(schedule.endTime).get(\"hour\") * 60 + dayjs.utc(schedule.endTime).get(\"minute\") - utcOffset;\n86:     // add to working hours, keeping startTime and endTimes between bounds (0-1439)\n87:     const sameDayStartTime = Math.max(MINUTES_DAY_START, Math.min(MINUTES_DAY_END, startTime));\n88:     const sameDayEndTime = Math.max(MINUTES_DAY_START, Math.min(MINUTES_DAY_END, endTime));\n89:     if (sameDayEndTime < sameDayStartTime) {\n90:       return currentWorkingHours;\n91:     }\n92:     if (sameDayStartTime !== sameDayEndTime) {\n93:       const newWorkingHours: WorkingHours = {\n94:         days: schedule.days,\n95:         startTime: sameDayStartTime,\n96:         endTime: sameDayEndTime,\n97:       };\n98:       if (schedule.userId) newWorkingHours.userId = schedule.userId;\n99:       currentWorkingHours.push(newWorkingHours);\n100:     }\n101:     // check for overflow to the previous day\n102:     // overflowing days constraint to 0-6 day range (Sunday-Saturday)\n103:     if (startTime < MINUTES_DAY_START || endTime < MINUTES_DAY_START) {\n104:       const newWorkingHours: WorkingHours = {\n105:         days: schedule.days.map((day) => (day - 1 >= 0 ? day - 1 : 6)),\n106:         startTime: startTime + MINUTES_IN_DAY,\n107:         endTime: Math.min(endTime + MINUTES_IN_DAY, MINUTES_DAY_END),\n108:       };\n109:       if (schedule.userId) newWorkingHours.userId = schedule.userId;\n110:       currentWorkingHours.push(newWorkingHours);\n111:     }\n112:     // else, check for overflow in the next day\n113:     else if (startTime > MINUTES_DAY_END || endTime > MINUTES_IN_DAY) {\n114:       const newWorkingHours: WorkingHours = {\n115:         days: schedule.days.map((day) => (day + 1) % 7),\n116:         startTime: Math.max(startTime - MINUTES_IN_DAY, MINUTES_DAY_START),\n117:         endTime: endTime - MINUTES_IN_DAY,\n118:       };\n119:       if (schedule.userId) newWorkingHours.userId = schedule.userId;\n120:       currentWorkingHours.push(newWorkingHours);\n121:     }\n122: \n123:     return currentWorkingHours;\n124:   }, []);\n125: \n126:   workingHours.sort((a, b) => a.startTime - b.startTime);\n127:   return workingHours;\n128: }\n129: \n130: export function availabilityAsString(\n131:   availability: Availability,\n132:   { locale, hour12 }: { locale?: string; hour12?: boolean }\n133: ) {\n134:   const weekSpan = (availability: Availability) => {\n135:     const days = availability.days.slice(1).reduce(\n136:       (days, day) => {\n137:         if (days[days.length - 1].length === 1 && days[days.length - 1][0] === day - 1) {\n138:           // append if the range is not complete (but the next day needs adding)\n139:           days[days.length - 1].push(day);\n140:         } else if (days[days.length - 1][days[days.length - 1].length - 1] === day - 1) {\n141:           // range complete, overwrite if the last day directly preceeds the current day\n142:           days[days.length - 1] = [days[days.length - 1][0], day];\n143:         } else {\n144:           // new range\n145:           days.push([day]);\n146:         }\n147:         return days;\n148:       },\n149:       [[availability.days[0]]] as number[][]\n150:     );",
